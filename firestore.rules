rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ================================
    // 辅助函数
    // ================================
    
    // 检查用户是否已认证
    function isSignedIn() {
      return request.auth != null;
    }
    
    // 获取用户文档
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // 检查用户角色
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    
    // 检查是否为高级管理员（admin / superAdmin / developer）
    // 用于敏感操作：财务、门店管理、系统配置、功能开关
    function isAdmin() {
      return isSignedIn() && getUserData().role in ['admin', 'superAdmin', 'developer'];
    }

    // 检查是否为门店管理员
    function isStoreAdmin() {
      return isSignedIn() && getUserData().role == 'storeAdmin';
    }

    // 检查是否为任意管理角色（含 storeAdmin）
    // 用于运营类集合：活动、订单、库存、积分、到访记录等
    function isAnyAdmin() {
      return isSignedIn() && getUserData().role in ['admin', 'superAdmin', 'developer', 'storeAdmin'];
    }

    // 检查是否为 VIP 会员
    function isVIP() {
      return hasRole('vip');
    }

    // 检查是否为普通会员
    function isMember() {
      return hasRole('member');
    }

    // 检查是否为活跃用户（member、vip 或任意管理员）
    function isActiveMember() {
      return isSignedIn() && (isMember() || isVIP() || isAnyAdmin());
    }
    
    // 检查是否为资源所有者
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // 检查用户状态是否活跃
    function isActiveUser() {
      return isSignedIn() && getUserData().status == 'active';
    }

    // Annual Pass is represented by users/{uid}.status. Activation upgrades
    // guest to member while every other role remains unchanged.
    function isSelfAnnualPassActivation(userId) {
      return isOwner(userId)
             && resource.data.status == 'inactive'
             && request.resource.data.status == 'active'
             && ((resource.data.role == 'guest' && request.resource.data.role == 'member')
                 || (resource.data.role != 'guest' && request.resource.data.role == resource.data.role))
             && request.resource.data.membership.points < resource.data.membership.points
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['membership', 'role', 'status', 'updatedAt']);
    }

    function isActiveReferredUser(referrerId, referredUserId) {
      return isSignedIn()
             && get(/databases/$(database)/documents/users/$(referredUserId)).data.status == 'active'
             && get(/databases/$(database)/documents/users/$(referredUserId)).data.referral.referredByUserId == referrerId;
    }
    
    // ================================
    // Users Collection
    // ================================
    match /users/{userId} {
      // 用户只能读取自己；高级管理员权限统一跟随 users/{uid}.role。
      allow get: if isOwner(userId) || isAdmin();
      // 兼容旧账号按邮箱定位自己的用户文档；查询必须限定为当前 Auth 邮箱。
      allow list: if isAdmin()
                  || (isSignedIn() && resource.data.email == request.auth.token.email)
                  || (isSignedIn()
                      && resource.data.referral.referredByUserId == request.auth.uid);

      // 创建：仅在注册时允许（特殊情况）
      allow create: if isSignedIn() && request.auth.uid == userId;

      // 更新：用户可以更新自己的数据，管理员可以更新所有
      allow update: if (isOwner(userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']))
                    || isSelfAnnualPassActivation(userId)
                    || isAdmin();

      // 删除：仅管理员
      allow delete: if isAdmin();

      match /referrals/{referralId} {
        allow read: if isOwner(userId) || isSignedIn();
        // 被推荐人成功开通 Annual Pass 后，只能为自己确认与既有推荐人的关系。
        allow create: if isAdmin()
                      || (isSignedIn()
                          && referralId == request.auth.uid
                          && request.resource.data.referredUserId == request.auth.uid
                          && getUserData().status == 'active'
                          && getUserData().referral.referredByUserId == userId)
                      || (isOwner(userId)
                          && request.resource.data.referredUserId == referralId
                          && isActiveReferredUser(userId, referralId));
        allow update: if isAdmin()
                      || (isSignedIn()
                          && referralId == request.auth.uid
                          && resource.data.referredUserId == request.auth.uid
                          && getUserData().status == 'active'
                          && getUserData().referral.referredByUserId == userId
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['membershipActivatedAt', 'updatedAt']))
                      || (isOwner(userId)
                          && resource.data.referredUserId == referralId
                          && isActiveReferredUser(userId, referralId)
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['membershipActivatedAt', 'updatedAt']));
        allow delete: if isAdmin();
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ================================
    // Events Collection
    // ================================
    match /events/{eventId} {
      // 读取：所有已认证用户都可以查看活动
      allow read: if isSignedIn();
      
      // 创建/更新/删除：任意管理员（含 storeAdmin）
      allow create, update, delete: if isAnyAdmin();
    }

    // ================================
    // Orders Collection
    // ================================
    match /orders/{orderId} {
      // 读取：用户可以查看自己的订单，任意管理员可以查看所有
      allow read: if isOwner(resource.data.userId) || isAnyAdmin();

      // 创建：任意管理员直接允许；活跃会员可创建
      allow create: if isAnyAdmin() || isActiveMember();

      // 更新/删除：任意管理员
      allow update, delete: if isAnyAdmin();
    }

    // ================================
    // Cigars/Inventory Collection
    // ================================
    match /cigars/{cigarId} {
      // 读取：所有已认证用户都可以查看库存
      allow read: if isSignedIn();

      // 创建/更新/删除：任意管理员（含 storeAdmin）
      allow create, update, delete: if isAnyAdmin();
    }

    // ================================
    // Brands Collection
    // ================================
    match /brands/{brandId} {
      // 读取：所有已认证用户都可以查看品牌
      allow read: if isSignedIn();

      // 创建/更新/删除：任意管理员（含 storeAdmin）
      allow create, update, delete: if isAnyAdmin();
    }
    
    // ================================
    // Points Records Collection
    // ================================
    match /pointsRecords/{recordId} {
      // 读取：用户可以查看自己的积分记录，任意管理员可以查看所有
      allow read: if isOwner(resource.data.userId) || isAnyAdmin();

      // 用户购买 Annual Pass / Day Pass 时可为自己写入消费记录。
      allow create: if isAnyAdmin()
                    || (isSignedIn()
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.type == 'spend'
                        && request.resource.data.source in ['membership_fee', 'visit']
                        && request.resource.data.amount > 0
                        && request.resource.data.balance >= 0);
      allow update, delete: if isAnyAdmin();
    }
    
    // ================================
    // Visit Sessions Collection
    // ================================
    match /visitSessions/{sessionId} {
      // 读取：用户可以查看自己的驻店记录，任意管理员可以查看所有
      allow read: if isOwner(resource.data.userId) || isAnyAdmin();

      // inactive 用户购买 Day Pass 时可为自己创建驻店记录，角色不限。
      allow create: if isAnyAdmin()
                    || isActiveMember()
                    || (isSignedIn()
                        && getUserData().status == 'inactive'
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.checkInType == 'daypass'
                        && request.resource.data.dayPass.isPurchased == true);

      // 更新：用户可以更新自己的记录，任意管理员可以更新所有
      allow update: if isOwner(resource.data.userId) || isAnyAdmin();

      // 删除：任意管理员
      allow delete: if isAnyAdmin();
    }
    
    // ================================
    // Redemption Records Collection
    // ================================
    match /redemptionRecords/{recordId} {
      // 读取：用户可以查看自己的兑换记录，任意管理员可以查看所有
      allow read: if isOwner(resource.data.userId) || isAnyAdmin();

      // Day Pass 事务可创建或合并用户本人的待兑换记录。
      allow create: if isAnyAdmin()
                    || (isSignedIn()
                        && getUserData().status == 'inactive'
                        && request.resource.data.userId == request.auth.uid);
      allow update: if isAnyAdmin()
                    || (isOwner(resource.data.userId)
                        && request.resource.data.userId == resource.data.userId);
      allow delete: if isAnyAdmin();
    }
    
    // ================================
    // Reload Records Collection (充值记录)
    // ================================
    match /reloadRecords/{recordId} {
      // 读取：用户可以查看自己的充值记录，任意管理员可以查看所有
      allow read: if isOwner(resource.data.userId) || isAnyAdmin();

      // 创建：所有已登录用户均可为自己提交充值申请（route 对所有角色开放）
      allow create: if isAnyAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);

      // 更新：任意管理员可以审核充值
      allow update: if isAnyAdmin();

      // 删除：任意管理员可删除任意记录；用户只能删除自己的 pending 记录（撤销申请）
      allow delete: if isAnyAdmin() || (isOwner(resource.data.userId) && resource.data.status == 'pending');
    }
    
    // ================================
    // Membership Fee Records Collection
    // ================================
    match /membershipFeeRecords/{recordId} {
      // 读取：用户可以查看自己的年费记录，任意管理员可以查看所有
      allow read: if isOwner(resource.data.userId) || isAnyAdmin();

      // 所有角色都可为自己提交 Annual Pass；系统仍按用户 status 判断权益。
      allow create: if isAnyAdmin()
                    || (isSignedIn()
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.status == 'pending'
                        && request.resource.data.amount > 0
                        && (request.resource.data.renewalType == 'renewal'
                            || getUserData().status == 'inactive'));
      allow update: if isAnyAdmin()
                    || (isOwner(resource.data.userId)
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'paid'
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.amount == resource.data.amount
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'deductedAt', 'pointsRecordId', 'updatedAt']));
      allow delete: if isAnyAdmin();
    }
    
    // ================================
    // Subscription Requests Collection (订阅激活请求)
    // ================================
    match /subscription_requests/{requestId} {
      // 读取：仅管理员
      allow read: if isAdmin();

      // 创建：管理员可以提交订阅请求
      allow create: if isAdmin();

      // 更新/删除：仅管理员
      allow update, delete: if isAdmin();
    }

    // ================================
    // Transactions Collection (财务记录)
    // ================================
    match /transactions/{transactionId} {
      // 读取：仅管理员
      allow read: if isAdmin();
      
      // 创建/更新/删除：仅管理员
      allow create, update, delete: if isAdmin();
    }
    
    // ================================
    // Inbound Orders Collection (入库订单)
    // ================================
    match /inbound_orders/{orderId} {
      allow read: if isAnyAdmin();
      allow create, update, delete: if isAnyAdmin();
    }

    // ================================
    // Outbound Orders Collection (出库订单)
    // ================================
    match /outbound_orders/{orderId} {
      allow read: if isAnyAdmin();
      allow create, update, delete: if isAnyAdmin();
    }

    // ================================
    // Inventory Movements Collection
    // ================================
    match /inventory_movements/{movementId} {
      allow read: if isAnyAdmin();
      allow create, update, delete: if isAnyAdmin();
    }
    
    // ================================
    // Config Collection (积分/年费等配置，实际路径 config/{docId})
    // ================================
    match /config/{configId} {
      // 读取：所有已认证用户都可以查看配置
      allow read: if isSignedIn();

      // 创建/更新/删除：任意管理员（含 storeAdmin，管理积分/到访配置）
      allow create, update, delete: if isAnyAdmin();
    }

    // ================================
    // Points Config Collection (保留向后兼容)
    // ================================
    match /pointsConfig/{configId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAnyAdmin();
    }

    // ================================
    // Membership Fee Config Collection (保留向后兼容)
    // ================================
    match /membershipFeeConfig/{configId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAnyAdmin();
    }
    
    // ================================
    // Stores Collection (门店)
    // ================================
    match /stores/{storeId} {
      // 读取：所有已认证用户可查看门店信息
      allow read: if isSignedIn();

      // 创建/更新/删除：仅管理员
      allow create, update, delete: if isAdmin();
    }

    // ================================
    // Rooms Collection (包厢)
    // ================================
    match /rooms/{roomId} {
      // 读取：所有已认证用户可查看包厢信息
      allow read: if isSignedIn();

      // 创建/更新/删除：仅管理员
      allow create, update, delete: if isAdmin();
    }

    // ================================
    // Room Bookings Collection (包厢预订)
    // ================================
    match /roomBookings/{bookingId} {
      // 读取：所有已登录用户可查看（已简化为 isSignedIn，含已有的 owner/admin 情况）
      allow read: if isSignedIn();

      // 创建：活跃会员可预订；任意管理员绕过状态检查
      allow create: if isAnyAdmin() || isActiveMember();

      // 更新：用户可更新自己的预订（如取消），任意管理员可更新所有
      allow update: if isOwner(resource.data.userId) || isAnyAdmin();

      // 删除：任意管理员
      allow delete: if isAnyAdmin();
    }

    // ================================
    // Feature Visibility Collection
    // ================================
    match /feature_visibility/{configId} {
      // 读取：所有已认证用户可查看功能可见性配置
      allow read: if isSignedIn();

      // 创建/更新/删除：仅管理员
      allow create, update, delete: if isAdmin();
    }

    // ================================
    // App Config Collection (应用配置)
    // ================================
    match /app_config/{configId} {
      // 读取：允许所有用户（包括未认证用户）读取应用配置
      // 这是必需的，因为登录页面需要读取配置来决定是否显示登录选项
      allow read: if true;
      
      // 创建/更新/删除：仅管理员
      allow create, update, delete: if isAdmin();
    }
    
    // ================================
    // Audit Logs Collection
    // ================================
    match /audit_logs/{logId} {
      // 读取：仅高级管理员（不含 storeAdmin，避免泄露敏感操作日志）
      allow read: if isAdmin();
      // 创建：任意管理员（storeAdmin 的操作也应写入审计日志）
      allow create: if isAnyAdmin();
      allow update, delete: if false;
    }

    // ================================
    // Announcements Collection（公告）
    // ================================
    match /announcements/{announcementId} {
      // 读取：所有已登录用户可读取公告
      allow read: if isSignedIn();

      // 创建/更新/删除：任意管理员（含 storeAdmin）
      allow create, update, delete: if isAnyAdmin();
    }

    // ================================
    // 默认拒绝规则
    // ================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

